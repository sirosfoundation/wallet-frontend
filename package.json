    "start": "vite --no-open",
    "start-docker": "npx vite --no-open",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "test": "VITE_CJS_IGNORE_WARNING=true vitest run",
    "test-start": "VITE_CJS_IGNORE_WARNING=true vitest",
