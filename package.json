  "scripts": {
    "start": "vite --no-open",
    "start-docker": "npx vite --no-open",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "test": "VITE_CJS_IGNORE_WARNING=true vitest run",
    "test-start": "VITE_CJS_IGNORE_WARNING=true vitest",
    "test:coverage": "VITE_CJS_IGNORE_WARNING=true vitest run --coverage",
    "translations": "node translation_coverage/translations.js",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput",
    "dev": "concurrently -k -n Types,Vite -c yellow,cyan \"pnpm typecheck:watch\" \"pnpm start\"",
    "dev:docker": "concurrently -k -n Types,Vite -c yellow,cyan \"pnpm typecheck:watch\" \"pnpm start-docker\"",
    "dev:test": "concurrently -k -n Types,Tests -c yellow,cyan \"pnpm typecheck:watch\" \"pnpm test-start\"",
    "changeset": "changeset add",
    "prerelease-mode": "changeset pre",
    "version": "dotenv -e .changeset/.env -- changeset version",
    "tag": "pnpm tag:public && pnpm tag:main",
    "tag:public": "changeset git-tag",
    "tag:main": "VER=\"v$(node -p \"require('./package.json').version\")\"; git tag \"$VER\" -m \"$VER\""
  },
  "repository": "https://github.com/wwwallet/wallet-frontend",
  "license": "BSD-2-Clause",
  "resolutions": {
    "minimatch": "^7.4.6",
    "brace-expansion": "^2.0.3",
    "picomatch": ">=2.3.2",
    "fast-uri": ">=3.1.0",
    "form-data": ">=4.0.4"
  }
}
