{
	"name": "@sirosfoundation/wallet-frontend-config-manager",
	"version": "0.0.0",
	"license": "BSD-2-Clause",
	"private": false,
	"main": "./dist/config_manager.js",
	"types": "./dist/config_manager.d.ts",
	"exports": {
		".": {
			"import": "./dist/config_manager.js",
			"default": "./dist/config_manager.js",
			"types": "./dist/config_manager.d.ts"
		}
	},
	"bin": {
		"wallet-frontend-config-manager": "./bin/cli.mjs"
	},
	"files": [
		"dist/config_manager_bg.wasm",
		"dist/config_manager.js",
		"dist/config_manager.d.ts",
		"bin/cli.mjs"
	],
	"scripts": {
		"build": "pnpm run build:wasm",
		"build:wasm": "wasm-pack build --release --no-pack --target nodejs --out-dir ./dist",
		"build:native": "cargo build --release --target x86_64-unknown-linux-musl"
	},
	"dependencies": {
		"commander": "^15.0.0"
