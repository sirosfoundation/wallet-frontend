{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"src/**/*.{ts,tsx,js,jsx}",
			"config/**/*.ts",
			"vite-plugins/**/*.ts",
			"packages/**/src/**/*.{ts,tsx,js,jsx}"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"domains": {
			"react": "recommended",
			"test": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"a11y": "warn",
			"complexity": "warn",
			"correctness": {
				"noNodejsModules": "off"
			},
			"performance": {
				"preset": "recommended",
				"noNamespaceImport": "warn",
				"noAwaitInLoops": "warn",
				"useTopLevelRegex": "warn",
				"noBarrelFile": "off",
				"noReExportAll": "off"
			},
			"security": "warn",
			"suspicious": "warn",
			"style": {
				"preset": "recommended",
				"useBlockStatements": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always"
		}
	},
	"overrides": [
		{
			"includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.test.js", "**/*.test.jsx"],
			"linter": {
				"rules": {
					"complexity": {
						"useArrowFunction": "off",
						"noExcessiveLinesPerFunction": "off"
					}
				}
			}
		}
	]
}
