{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"src/**/*.{ts,tsx,js,jsx}",
			"config/**/*.ts",
			"vite-plugins/**/*.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"domains": {
			"react": "recommended",
			"test": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"style": {
				"useNamingConvention": {
					"level": "error",
					"options": {
						"strictCase": true,
						"conventions": [
							{
								"selector": { "kind": "objectLiteralProperty" },
								"formats": ["camelCase", "snake_case", "CONSTANT_CASE"]
							},
							{
								"selector": { "kind": "typeProperty" },
								"formats": ["camelCase", "snake_case", "CONSTANT_CASE"]
							}
						]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always"
		}
	}
}
