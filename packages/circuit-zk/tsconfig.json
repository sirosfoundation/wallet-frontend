{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2023", "dom"],
		"module": "es2022",
		"rootDir": "./src",
		"moduleResolution": "bundler",
		"declaration": true,
		"declarationMap": true,
		"inlineSourceMap": true,
		"outDir": "./dist",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
